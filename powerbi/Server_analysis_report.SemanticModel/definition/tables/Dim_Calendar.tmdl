	partition Dim_Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "Month Number", MONTH([Date]),
				    "Day of Week", FORMAT([Date], "ddd"),
				    "Date String", FORMAT([Date], "yyyy-mm-dd")
				)

